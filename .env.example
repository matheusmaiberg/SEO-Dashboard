# Copie para .env e ajuste os valores antes de subir com docker-compose.
# No Coolify, defina essas mesmas chaves na aba Environment Variables do
# recurso (Docker Compose) criado a partir deste repositório.

# URL pública do backend, acessível pelo NAVEGADOR do usuário (não é o nome
# do serviço docker interno). É embutida no build do frontend — precisa
# estar definida ANTES de gerar a imagem.
# Local:      http://localhost:5001
# Produção:   https://api.seudominio.com
NEXT_PUBLIC_API_URL=http://localhost:5001

# Origem(ns) permitida(s) pelo CORS do backend — a URL pública do frontend.
# Separe múltiplas origens por vírgula.
# Local:      http://localhost:3000
# Produção:   https://dashboard.seudominio.com
FRONTEND_ORIGIN=http://localhost:3000

# Porta interna do backend Flask (o Dockerfile.backend já expõe 5001).
PORT=5001
